SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=*

# Africa's Talking SMS (get credentials at africastalking.com)
AT_USERNAME=sandbox
AT_API_KEY=your-api-key-here
AT_SENDER_ID=HealthBot
AT_SHORTCODE=

# Set to True to send real SMS (False = simulation/logging only)
SMS_ENABLED=False

# Set to False to disable background reminder scheduler
SCHEDULER_ENABLED=True

# DHIS2 Integration (Ethiopia national HMIS)
DHIS2_URL=https://play.dhis2.org/40/
DHIS2_USERNAME=admin
DHIS2_PASSWORD=district
DHIS2_ORG_UNIT=ImspTQPwCqd
DHIS2_DATASET_UID=pBOMPrpg1QX

# Google Places API (for real-time nearby facility search)
# Get free key at: https://console.cloud.google.com → Enable "Places API"
# Free tier: 28,500 requests/month
GOOGLE_PLACES_API_KEY=your-google-places-api-key-here

# Google Cloud Translation API
# Get key at: https://console.cloud.google.com → Enable "Cloud Translation API"
# Free tier: 500,000 characters/month
# After setting key, run: python scripts/generate_translations.py
GOOGLE_TRANSLATE_API_KEY=your-google-translate-api-key-here

# Auto-load pre-built translations into SQLite cache on startup
TRANSLATION_PRELOAD=True
